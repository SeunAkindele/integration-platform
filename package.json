{
  "name": "integration-platform",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "build:api-gateway": "nest build api-gateway",
    "build:integration-service": "nest build integration-service",
    "build:webhook-processor": "nest build webhook-processor",

    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",

    "start:api-gateway": "nest start api-gateway",
    "start:api-gateway:dev": "nest start api-gateway --watch",
    "start:webhook-processor": "nest start webhook-processor",
    "start:webhook-processor:dev": "nest start webhook-processor --watch",
    "start:integration-service": "nest start integration-service",
    "start:integration-service:dev": "nest start integration-service --watch",

    "start:prod": "node dist/apps/integration-platform/main",
    "start:api-gateway:prod": "node dist/apps/api-gateway/main",
    "start:webhook-processor:prod": "node dist/apps/webhook-processor/main",

    "migration:run:webhook": "typeorm-ts-node-commonjs migration:run -d apps/webhook-processor/src/data-source.ts",
    "migration:revert:webhook": "typeorm-ts-node-commonjs migration:revert -d apps/webhook-processor/src/data-source.ts",
    "migration:generate:webhook": "typeorm-ts-node-commonjs migration:generate -d apps/webhook-processor/src/data-source.ts",

    "migration:run:dlq": "typeorm-ts-node-commonjs migration:run -d apps/webhook-processor/src/data-source.ts",
    "migration:revert:dlq": "typeorm-ts-node-commonjs migration:revert -d apps/webhook-processor/src/data-source.ts",
    "migration:generate:dlq": "typeorm-ts-node-commonjs migration:generate -d apps/webhook-processor/src/data-source.ts",

    "migration:run:integration": "typeorm-ts-node-commonjs migration:run -d apps/integration-service/src/data-source.ts",
    "migration:revert:integration": "typeorm-ts-node-commonjs migration:revert -d apps/integration-service/src/data-source.ts",
    "migration:generate:integration": "typeorm-ts-node-commonjs migration:generate -d apps/integration-service/src/data-source.ts",

    "infra:start": "nats-server -js -m 8222 & brew services start postgresql@16",
    "infra:stop": "pkill nats-server; brew services stop postgresql@16",
    "infra:docker": "docker compose -f infrastructure/docker/docker-compose.yml up -d nats postgres",
    "infra:docker:stop": "docker compose -f infrastructure/docker/docker-compose.yml down",

    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./apps/integration-platform/test/jest-e2e.json"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.1",
    "@nestjs/microservices": "^11.1.16",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/typeorm": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.3.1",
    "nats": "^2.29.3",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.7",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^@app/common(|/.*)$": "<rootDir>/libs/common/src/$1"
    }
  }
}